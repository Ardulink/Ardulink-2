<?xml version="1.0" encoding="UTF-8"?>
<!--
	Template for ~/.m2/settings.xml needed to publish to Maven Central.

	Setup (one time):

	  1. Copy this file to ~/.m2/settings.xml

	       cp settings-release.xml.example ~/.m2/settings.xml

	  2. Merge the <servers> block below into your existing ~/.m2/settings.xml
	     if you already have one (do NOT just overwrite it - it holds your
	     mirror/proxy configuration).

	  3. Generate a user token at https://central.sonatype.com
	     ("Account" -> "Generate User Token" -> "Central Publishing Token")
	     and put the token name and password below.

	     The token name/password are NOT your Sonatype account login.
	-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

	<servers>
		<!--
			The id MUST be "central" - it is referenced by
			<publishingServerId> in the "release" profile of pom.xml.
		-->
		<server>
			<id>central</id>
			<username>REPLACE_WITH_CENTRAL_TOKEN_USERNAME</username>
			<password>REPLACE_WITH_CENTRAL_TOKEN_PASSWORD</password>
		</server>
	</servers>

</settings>